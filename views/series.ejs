<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Browse Series - Notes from the Majlis</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600;700&family=Amiri:wght@400;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

  <!-- Navigation -->
  <nav>
    <div class="nav-container">
      <a href="/" class="logo">Notes from the Majlis</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/topics">Browse Topics</a></li>
        <li><a href="/series" class="active">Browse Series</a></li>
        <% if (isAdmin) { %>
        <li><a href="/admin" style="color: var(--terracotta); font-weight: 600;">Admin Panel</a></li>
        <% } %>
        <% if (user) { %>
        <li><a href="/profile"><%= user.name %></a></li>
        <li><a href="/auth/logout">Logout</a></li>
        <% } %>
      </ul>
    </div>
  </nav>

  <!-- Page Hero -->
  <section class="hero" style="padding: 4rem 2rem;">
    <div class="hero-content">
      <h1 style="margin-bottom: 1rem;">Browse All Series</h1>
      <p class="hero-subtitle">Complete course series with sequential lessons</p>
    </div>
  </section>

  <!-- Main Content -->
  <main style="padding: 3rem 0; background: white;">
    <div class="container">

      <% if (allSeries && allSeries.length > 0) { %>
        <div class="lessons-grid">
          <% allSeries.forEach(series => { %>
          <div class="lesson-card">
            <div class="lesson-meta">
              <span class="lesson-tag" style="background: var(--soft-beige); color: var(--<%= series.category.toLowerCase() %>);">
                <%= series.category %>
              </span>
              <span class="lesson-tag"><%= series.totalLessons || 0 %> lessons</span>
            </div>

            <h3><%= series.titleEnglish %></h3>
            <% if (series.titleArabic) { %>
            <p class="arabic-title"><%= series.titleArabic %></p>
            <% } %>

            <p class="lesson-info" style="margin: 1rem 0; color: var(--text-secondary);">
              By <%= series.author %>
            </p>

            <% if (series.description) { %>
            <p class="lesson-excerpt"><%= series.description.substring(0, 150) %><%= series.description.length > 150 ? '...' : '' %></p>
            <% } %>

            <div class="lesson-footer" style="margin-top: 1.5rem; padding-top: 1rem; border-top: 1px solid var(--border-light); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
              <div style="display: flex; flex-direction: column; gap: 0.25rem;">
                <span class="lesson-info"><strong>Status:</strong> <%= series.status %></span>
                <% if (series.latestLesson) { %>
                <span class="lesson-info" style="font-size: 0.85rem;">
                  Latest: Lesson <%= series.latestLesson.lessonNumber %>
                </span>
                <% } %>
              </div>
              <a href="/series/<%= series.seriesId %>" class="lesson-link">
                View Series →
              </a>
            </div>
          </div>
          <% }); %>
        </div>
      <% } else { %>
        <div style="text-align: center; padding: 4rem 2rem; background: var(--soft-beige); border-radius: var(--radius-lg);">
          <h3 style="font-family: var(--font-display); font-size: 1.5rem; color: var(--text-secondary); margin-bottom: 1rem;">
            No Series Available
          </h3>
          <p style="color: var(--text-light);">Check back soon for new course series.</p>
        </div>
      <% } %>

    </div>
  </main>

  <!-- Footer -->
  <footer>
    <div class="footer-content">
      <div class="footer-note">
        <p><strong>Important Notice:</strong> These are unofficial AI-assisted student notes. They have not been reviewed or endorsed by Sheikh Hassan Dghriri. Always verify information from the original audio recordings.</p>
      </div>
      <p class="footer-copyright">&copy; 2025 Notes from the Majlis. Educational purposes only.</p>
    </div>
  </footer>

</body>
</html>
