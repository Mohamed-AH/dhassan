<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Edit Lesson - <%= lesson.titleEnglish || `Lesson ${lesson.lessonNumber}` %> - Admin</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="stylesheet" href="/lib/easymde/easymde.min.css">
  <style>
    .admin-editor-container {
      max-width: 100%;
      padding: 2rem;
      background: var(--warm-cream);
      min-height: 100vh;
    }

    .admin-editor-header {
      max-width: 1400px;
      margin: 0 auto 2rem;
      padding: 2rem;
      background: white;
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-light);
    }

    .admin-editor-header h1 {
      font-family: var(--font-display);
      font-size: 2rem;
      color: var(--terracotta);
      margin-bottom: 0.5rem;
    }

    .lesson-info {
      color: var(--text-secondary);
      font-size: 0.95rem;
    }

    .admin-editor-main {
      max-width: 1400px;
      margin: 0 auto;
    }

    .metadata-section {
      background: white;
      padding: 2rem;
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-light);
      margin-bottom: 2rem;
    }

    .metadata-section h2 {
      font-family: var(--font-display);
      color: var(--text-primary);
      margin-bottom: 1.5rem;
      padding-bottom: 0.75rem;
      border-bottom: 2px solid var(--soft-beige);
    }

    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 1.5rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
    }

    .form-group label {
      font-weight: 600;
      margin-bottom: 0.5rem;
      color: var(--text-primary);
    }

    .form-group input,
    .form-group select {
      padding: 0.75rem 1rem;
      border: 1px solid var(--border-light);
      border-radius: var(--radius-sm);
      font-family: inherit;
      font-size: 1rem;
    }

    .form-group input:focus,
    .form-group select:focus {
      outline: none;
      border-color: var(--terracotta);
    }

    .form-group.full-width {
      grid-column: 1 / -1;
    }

    .editor-actions {
      display: flex;
      gap: 1rem;
      margin-bottom: 1.5rem;
      align-items: center;
      flex-wrap: wrap;
    }

    .btn-save {
      background: var(--terracotta);
      color: white;
      padding: 0.875rem 2rem;
      border: none;
      border-radius: var(--radius-sm);
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .btn-save:hover {
      background: var(--burnt-orange);
    }

    .btn-save:disabled {
      opacity: 0.5;
      cursor: not-allowed;
    }

    .btn-cancel {
      background: var(--soft-beige);
      color: var(--text-primary);
      padding: 0.875rem 2rem;
      border: 1px solid var(--border-light);
      border-radius: var(--radius-sm);
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.3s ease;
      text-decoration: none;
      display: inline-block;
    }

    .btn-cancel:hover {
      background: var(--warm-sand);
      border-color: var(--text-secondary);
    }

    .btn-delete {
      background: #dc3545;
      color: white;
      padding: 0.875rem 2rem;
      border: none;
      border-radius: var(--radius-sm);
      font-weight: 600;
      font-size: 1rem;
      cursor: pointer;
      transition: all 0.3s ease;
      margin-left: auto;
    }

    .btn-delete:hover {
      background: #c82333;
    }

    .save-status {
      color: var(--text-secondary);
      font-size: 0.9rem;
    }

    .save-status.success {
      color: var(--olive-green);
      font-weight: 600;
    }

    .save-status.error {
      color: #d32f2f;
      font-weight: 600;
    }

    .notes-section {
      background: white;
      padding: 2rem;
      border-radius: var(--radius-lg);
      border: 1px solid var(--border-light);
    }

    .notes-section h2 {
      font-family: var(--font-display);
      color: var(--text-primary);
      margin-bottom: 1.5rem;
      padding-bottom: 0.75rem;
      border-bottom: 2px solid var(--soft-beige);
    }

    /* Customize EasyMDE */
    .EasyMDEContainer .CodeMirror {
      min-height: 500px;
      font-size: 1rem;
      line-height: 1.8;
    }

    .editor-toolbar {
      background: var(--soft-beige);
      border-color: var(--border-light);
    }

    .editor-toolbar button:hover,
    .editor-toolbar button.active {
      background: var(--terracotta) !important;
      border-color: var(--terracotta) !important;
    }

    .admin-tips {
      background: var(--soft-beige);
      padding: 1.5rem;
      border-radius: var(--radius-sm);
      border-left: 4px solid var(--muted-gold);
      margin-top: 2rem;
    }

    .admin-tips h3 {
      font-family: var(--font-display);
      font-size: 1.1rem;
      color: var(--text-primary);
      margin-bottom: 1rem;
    }

    .admin-tips ul {
      list-style: none;
      padding: 0;
    }

    .admin-tips li {
      padding: 0.5rem 0;
      color: var(--text-secondary);
      line-height: 1.6;
      font-size: 0.9rem;
    }

    .admin-tips li::before {
      content: '✓';
      color: var(--olive-green);
      font-weight: bold;
      margin-right: 0.75rem;
    }
  </style>
</head>
<body>

  <!-- Navigation -->
  <nav>
    <div class="nav-container">
      <a href="/" class="logo">Notes from the Majlis</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/admin">Admin Panel</a></li>
        <li><a href="/lesson/<%= lesson.seriesId %>/<%= lesson.lessonNumber %>">View Lesson</a></li>
        <% if (user) { %>
        <li><a href="/auth/logout">Logout</a></li>
        <% } %>
      </ul>
    </div>
  </nav>

  <div class="admin-editor-container">
    <!-- Header -->
    <div class="admin-editor-header">
      <h1>✏️ Edit Lesson</h1>
      <div class="lesson-info">
        <strong>Series:</strong> <%= series.titleEnglish %> |
        <strong>Lesson:</strong> <%= lesson.lessonNumber %>
      </div>
    </div>

    <!-- Editor -->
    <div class="admin-editor-main">
      <form id="lesson-edit-form">

        <!-- Metadata Section -->
        <div class="metadata-section">
          <h2>Lesson Information</h2>
          <div class="form-grid">
            <div class="form-group">
              <label for="titleEnglish">Title (English) *</label>
              <input type="text" id="titleEnglish" name="titleEnglish" value="<%= lesson.titleEnglish || '' %>" required>
            </div>

            <div class="form-group">
              <label for="titleArabic">Title (Arabic)</label>
              <input type="text" id="titleArabic" name="titleArabic" value="<%= lesson.titleArabic || '' %>">
            </div>

            <div class="form-group">
              <label for="hadithsDisplay">Hadiths (e.g., "Hadiths 26-30")</label>
              <input type="text" id="hadithsDisplay" name="hadithsDisplay" value="<%= lesson.hadithsDisplay || '' %>">
            </div>

            <div class="form-group">
              <label for="duration">Duration (e.g., "1h 45m")</label>
              <input type="text" id="duration" name="duration" value="<%= lesson.duration || '' %>">
            </div>

            <div class="form-group">
              <label for="dateGregorian">Date (Gregorian)</label>
              <input type="date" id="dateGregorian" name="dateGregorian" value="<%= lesson.dateGregorian ? new Date(lesson.dateGregorian).toISOString().split('T')[0] : '' %>">
            </div>

            <div class="form-group">
              <label for="lessonNumber">Lesson Number *</label>
              <input type="number" id="lessonNumber" name="lessonNumber" value="<%= lesson.lessonNumber %>" required min="1">
            </div>
          </div>

          <!-- Review Status -->
          <div class="form-group" style="margin-top: 1.5rem; padding: 1rem; background: var(--soft-beige); border-radius: 8px;">
            <label style="display: flex; align-items: center; cursor: pointer; font-weight: 600;">
              <input type="checkbox" id="isReviewed" name="isReviewed" <%= lesson.isReviewed ? 'checked' : '' %> style="margin-right: 0.75rem; width: 20px; height: 20px; cursor: pointer;">
              <span style="color: var(--sage-green);">✓ Mark as Reviewed (Visible to Public)</span>
            </label>
            <% if (lesson.reviewedBy) { %>
              <p style="margin: 0.75rem 0 0 2rem; font-size: 0.85rem; color: var(--text-secondary);">
                Reviewed by <strong><%= lesson.reviewedBy %></strong> on <%= new Date(lesson.reviewedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
              </p>
            <% } else { %>
              <p style="margin: 0.75rem 0 0 2rem; font-size: 0.85rem; color: var(--text-light);">
                <em>Not yet reviewed - lesson is only visible to admins</em>
              </p>
            <% } %>
          </div>
        </div>

        <!-- Notes Section -->
        <div class="notes-section">
          <h2>Lesson Notes (Markdown)</h2>
          <textarea id="markdown-editor"><%= lesson.notes %></textarea>

          <div class="admin-tips">
            <h3>💡 Editing Tips</h3>
            <ul>
              <li>Use <code>## Heading</code> for chapter headings (auto-generates table of contents)</li>
              <li>Timestamps format: <code>(HH:MM-HH:MM)</code> will be automatically extracted</li>
              <li>Click the eye icon (👁️) to toggle preview mode</li>
              <li>Changes will auto-update chapters and timestamps</li>
              <li>Press Ctrl+S (Cmd+S) to save quickly</li>
            </ul>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="editor-actions" style="margin-top: 2rem;">
          <button type="submit" class="btn-save" id="save-btn">
            💾 Save All Changes
          </button>
          <a href="/lesson/<%= lesson.seriesId %>/<%= lesson.lessonNumber %>" class="btn-cancel">
            ← Cancel
          </a>
          <span class="save-status" id="save-status"></span>
          <% if (adminRole === 'super-admin') { %>
          <button type="button" class="btn-delete" id="delete-btn">
            🗑️ Delete Lesson
          </button>
          <% } %>
        </div>
      </form>
    </div>
  </div>

  <!-- EasyMDE JavaScript -->
  <script src="/lib/easymde/easymde.min.js"></script>
  <script>
    // Initialize EasyMDE
    const easyMDE = new EasyMDE({
      element: document.getElementById('markdown-editor'),
      spellChecker: false,
      autosave: {
        enabled: true,
        uniqueId: 'lesson-<%= lesson._id %>',
        delay: 5000,
      },
      toolbar: [
        'bold', 'italic', 'heading', '|',
        'quote', 'unordered-list', 'ordered-list', '|',
        'link', 'image', '|',
        'preview', 'side-by-side', 'fullscreen', '|',
        'guide'
      ],
      placeholder: 'Enter lesson notes in Markdown format...',
    });

    // Form submission
    document.getElementById('lesson-edit-form').addEventListener('submit', async (e) => {
      e.preventDefault();

      const saveBtn = document.getElementById('save-btn');
      const saveStatus = document.getElementById('save-status');

      // Gather all form data
      const formData = {
        titleEnglish: document.getElementById('titleEnglish').value.trim(),
        titleArabic: document.getElementById('titleArabic').value.trim(),
        hadithsDisplay: document.getElementById('hadithsDisplay').value.trim(),
        duration: document.getElementById('duration').value.trim(),
        dateGregorian: document.getElementById('dateGregorian').value,
        lessonNumber: parseInt(document.getElementById('lessonNumber').value),
        notes: easyMDE.value(),
        isReviewed: document.getElementById('isReviewed').checked
      };

      // Validate
      if (!formData.titleEnglish) {
        alert('English title is required');
        return;
      }

      if (!formData.lessonNumber || formData.lessonNumber < 1) {
        alert('Valid lesson number is required');
        return;
      }

      // Disable button
      saveBtn.disabled = true;
      saveBtn.textContent = '💾 Saving...';
      saveStatus.textContent = '';
      saveStatus.className = 'save-status';

      try {
        const response = await fetch('/admin/lesson/<%= lesson._id %>/update', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(formData)
        });

        const result = await response.json();

        if (result.success) {
          saveStatus.textContent = '✓ Saved successfully!';
          saveStatus.className = 'save-status success';

          // Clear autosave
          easyMDE.clearAutosavedValue();

          // Update initial value to prevent "unsaved changes" warning
          initialValue = JSON.stringify({
            titleEnglish: document.getElementById('titleEnglish').value,
            notes: easyMDE.value()
          });

          // Re-enable button and keep user on page
          saveBtn.disabled = false;
          saveBtn.textContent = '💾 Save All Changes';

          // Clear success message after 3 seconds
          setTimeout(() => {
            saveStatus.textContent = '';
          }, 3000);
        } else {
          throw new Error(result.error || 'Failed to save');
        }
      } catch (error) {
        console.error('Save error:', error);
        saveStatus.textContent = '✗ Error: ' + error.message;
        saveStatus.className = 'save-status error';
        saveBtn.disabled = false;
        saveBtn.textContent = '💾 Save All Changes';
      }
    });

    // Delete lesson (super-admin only)
    <% if (adminRole === 'super-admin') { %>
    document.getElementById('delete-btn').addEventListener('click', async () => {
      const lessonTitle = '<%= lesson.titleEnglish || `Lesson ${lesson.lessonNumber}` %>';

      if (!confirm(`⚠️ Are you sure you want to DELETE this lesson?\n\n"${lessonTitle}"\n\nThis action CANNOT be undone!`)) {
        return;
      }

      if (!confirm('Are you ABSOLUTELY sure? This will permanently delete all lesson data.')) {
        return;
      }

      try {
        const response = await fetch('/admin/lesson/<%= lesson._id %>/delete', {
          method: 'DELETE',
          headers: {
            'Content-Type': 'application/json'
          }
        });

        const result = await response.json();

        if (result.success) {
          alert('✓ Lesson deleted successfully');
          window.location.href = '/admin/lessons';
        } else {
          throw new Error(result.error || 'Failed to delete');
        }
      } catch (error) {
        console.error('Delete error:', error);
        alert('✗ Error: ' + error.message);
      }
    });
    <% } %>

    // Keyboard shortcut: Ctrl+S / Cmd+S to save
    document.addEventListener('keydown', (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key === 's') {
        e.preventDefault();
        document.getElementById('lesson-edit-form').dispatchEvent(new Event('submit'));
      }
    });

    // Warn on page leave if there are unsaved changes
    let initialValue = JSON.stringify({
      titleEnglish: document.getElementById('titleEnglish').value,
      notes: easyMDE.value()
    });

    window.addEventListener('beforeunload', (e) => {
      const currentValue = JSON.stringify({
        titleEnglish: document.getElementById('titleEnglish').value,
        notes: easyMDE.value()
      });

      if (currentValue !== initialValue) {
        e.preventDefault();
        e.returnValue = '';
        return '';
      }
    });
  </script>

</body>
</html>
