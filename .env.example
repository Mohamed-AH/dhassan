# MongoDB Connection String
# Get this from MongoDB Atlas: https://www.mongodb.com/cloud/atlas
# Example: mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/dhassan-study?retryWrites=true&w=majority
DB_STRING=your_mongodb_connection_string_here

# Server Port (optional - will use 8000 by default, deployment platforms override this)
PORT=8000

# Environment (development or production)
NODE_ENV=development

# Session Secret (generate a random string - used for encrypting sessions)
# IMPORTANT: Generate a secure random string for production!
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=your_random_secret_key_minimum_32_characters_long

# Application URLs
# Development
DEVELOPMENT_URL=http://localhost:8000
# Production (update this when you deploy)
PRODUCTION_URL=https://your-app.onrender.com

# Google OAuth
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
# For production: https://your-app.onrender.com/auth/google/callback
# For development: http://localhost:8000/auth/google/callback
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback

# GitHub OAuth (optional)
# Get these from: https://github.com/settings/developers
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
