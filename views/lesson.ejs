<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>
    <% if (lesson.titleEnglish) { %>
      <%= lesson.titleEnglish %> - <%= series.titleEnglish %>
    <% } else { %>
      Lesson <%= lesson.lessonNumber %> - <%= series.titleEnglish %>
    <% } %>
    - Notes from the Majlis
  </title>
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600;700&family=Amiri:wght@400;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">

  <!-- Marked.js for markdown rendering -->
  <script src="https://cdn.jsdelivr.net/npm/marked/marked.min.js"></script>
  <script src="https://cdn.jsdelivr.net/npm/dompurify@3.0.6/dist/purify.min.js"></script>
</head>
<body data-user-logged-in="<%= user ? 'true' : 'false' %>" data-lesson-id="<%= lesson.seriesId %>/<%= lesson.lessonNumber %>">

  <!-- Navigation -->
  <nav>
    <div class="nav-container">
      <a href="/" class="logo">Notes from the Majlis</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/topics">Browse Topics</a></li>
        <li><a href="/series">Browse Series</a></li>
        <% if (isAdmin) { %>
        <li><a href="/admin" style="color: var(--terracotta); font-weight: 600;">Admin Panel</a></li>
        <% } %>
        <% if (user) { %>
        <li><a href="/profile"><%= user.name %></a></li>
        <li><a href="/auth/logout">Logout</a></li>
        <% } %>
      </ul>
    </div>
  </nav>

  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-separator">/</span>
        <a href="/series">Series</a>
        <span class="breadcrumb-separator">/</span>
        <a href="/series/<%= series.seriesId %>"><%= series.titleEnglish %></a>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current">Lesson <%= lesson.lessonNumber %></span>
      </nav>
    </div>
  </div>

  <!-- Lesson Hero Header -->
  <section class="lesson-hero">
    <div class="lesson-hero-content">
      <a href="/series/<%= series.seriesId %>" class="back-link">
        ← Back to <%= series.titleEnglish %>
      </a>

      <div class="lesson-meta-badges">
        <span class="lesson-badge">Lesson <%= lesson.lessonNumber %></span>
        <% if (lesson.hadithsCovered) { %>
        <span class="lesson-badge">Hadiths <%= lesson.hadithsCovered %></span>
        <% } %>
        <% if (lesson.duration) { %>
        <span class="lesson-badge">⏱ <%= lesson.duration %></span>
        <% } %>
      </div>

      <h1 class="lesson-title-main">
        <%= lesson.titleEnglish || `Lesson ${lesson.lessonNumber}` %>
      </h1>

      <% if (lesson.titleArabic) { %>
      <h2 class="lesson-title-arabic"><%= lesson.titleArabic %></h2>
      <% } %>

      <!-- Lesson Metadata -->
      <div class="lesson-metadata">
        <div class="metadata-grid">
          <% if (lesson.bookNameEnglish) { %>
          <div class="metadata-item">
            <span class="metadata-icon">📚</span>
            <div class="metadata-content">
              <span class="metadata-label">Book</span>
              <span class="metadata-value"><%= lesson.bookNameEnglish %></span>
              <% if (lesson.bookAuthorEnglish) { %>
              <span class="metadata-subvalue">by <%= lesson.bookAuthorEnglish %></span>
              <% } %>
            </div>
          </div>
          <% } %>

          <div class="metadata-item">
            <span class="metadata-icon">👤</span>
            <div class="metadata-content">
              <span class="metadata-label">Sheikh</span>
              <span class="metadata-value"><%= series.author %></span>
            </div>
          </div>

          <% if (lesson.location) { %>
          <div class="metadata-item">
            <span class="metadata-icon">📍</span>
            <div class="metadata-content">
              <span class="metadata-label">Location</span>
              <span class="metadata-value"><%= lesson.location %></span>
            </div>
          </div>
          <% } %>

          <div class="metadata-item">
            <span class="metadata-icon">📅</span>
            <div class="metadata-content">
              <span class="metadata-label">Date</span>
              <span class="metadata-value">
                <%= new Date(lesson.dateGregorian || lesson.date).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %>
              </span>
              <% if (lesson.dateHijri) { %>
              <span class="metadata-subvalue"><%= lesson.dateHijri %></span>
              <% } %>
            </div>
          </div>
        </div>
      </div>

      <!-- Audio Links -->
      <div class="lesson-audio-section">
        <% if (lesson.telegramLink) { %>
        <a href="<%= lesson.telegramLink %>" target="_blank" rel="noopener noreferrer" class="audio-link-primary">
          <span class="audio-icon">📱</span>
          Open in Telegram
        </a>
        <% } else if (lesson.audioLink) { %>
        <a href="<%= lesson.audioLink %>" target="_blank" rel="noopener noreferrer" class="audio-link-primary">
          <span class="audio-icon">🎧</span>
          Listen to Recording
        </a>
        <% } %>

        <!-- Admin Edit Button -->
        <% if (isAdmin) { %>
        <a href="/admin/lesson/<%= lesson._id %>/edit" class="audio-link-secondary">
          <span class="audio-icon">✏️</span>
          Edit Lesson
        </a>
        <% } %>

        <% if (lesson.whatsappLink) { %>
        <a href="<%= lesson.whatsappLink %>" target="_blank" rel="noopener noreferrer" class="audio-link-secondary">
          <span class="audio-icon">💬</span>
          Join WhatsApp Group
        </a>
        <% } %>
      </div>
    </div>
  </section>

  <!-- Disclaimer Banner -->
  <div class="lesson-disclaimer-banner">
    <div class="container">
      <div class="disclaimer-content">
        <strong>⚠️ Student Notes:</strong> These are AI-assisted summaries not reviewed by Sheikh Hassan Dghriri. Always verify from the original recording.
      </div>
    </div>
  </div>

  <!-- Quick Summary Section -->
  <% if (lesson.summary || (lesson.chaptersCovered && lesson.chaptersCovered.length > 0)) { %>
  <section class="lesson-summary-section">
    <div class="container">
      <div class="summary-card">
        <h2 class="summary-title">📝 Quick Summary</h2>
        <% if (lesson.summary) { %>
        <p class="summary-text"><%= lesson.summary %></p>
        <% } %>

        <% if (lesson.chaptersCovered && lesson.chaptersCovered.length > 0) { %>
        <div class="chapters-overview">
          <h3 class="chapters-title">Chapters Covered:</h3>
          <ul class="chapters-list">
            <% lesson.chaptersCovered.forEach((chapter, index) => { %>
            <li class="chapter-item">
              <a href="#chapter-<%= index + 1 %>" class="chapter-link"><%= chapter %></a>
            </li>
            <% }); %>
          </ul>
        </div>
        <% } %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Main Lesson Content -->
  <main class="lesson-main">
    <div class="lesson-container">

      <!-- Sidebar: Table of Contents -->
      <aside class="lesson-sidebar">
        <div class="lesson-sidebar-sticky">
          <nav class="lesson-toc">
            <h3 class="toc-title">Contents</h3>
            <div id="toc-content" class="toc-content">
              <!-- Will be populated by JavaScript from markdown headings -->
            </div>
          </nav>

          <!-- Timestamps in Sidebar -->
          <% if (lesson.timestamps && lesson.timestamps.length > 0) { %>
          <div class="sidebar-timestamps">
            <h3 class="toc-title">Timestamps</h3>
            <ul class="timestamps-quick-list">
              <% lesson.timestamps.slice(0, 5).forEach(timestamp => { %>
              <li class="timestamp-quick-item">
                <% if (lesson.telegramLink || lesson.audioLink) { %>
                <a href="<%= lesson.telegramLink || lesson.audioLink %>" target="_blank" class="timestamp-quick-link">
                  <span class="timestamp-time"><%= timestamp.time %></span>
                  <span class="timestamp-desc"><%= timestamp.description.substring(0, 30) %><%= timestamp.description.length > 30 ? '...' : '' %></span>
                </a>
                <% } else { %>
                <span class="timestamp-quick-link">
                  <span class="timestamp-time"><%= timestamp.time %></span>
                  <span class="timestamp-desc"><%= timestamp.description.substring(0, 30) %><%= timestamp.description.length > 30 ? '...' : '' %></span>
                </span>
                <% } %>
              </li>
              <% }); %>
              <% if (lesson.timestamps.length > 5) { %>
              <li class="timestamp-quick-item">
                <a href="#timestamps" class="timestamp-quick-link">+ <%= lesson.timestamps.length - 5 %> more...</a>
              </li>
              <% } %>
            </ul>
          </div>
          <% } %>
        </div>
      </aside>

      <!-- Main Content Area -->
      <article class="lesson-content">

        <!-- Rendered Markdown Notes -->
        <div id="lesson-notes-rendered" class="lesson-notes-content">
          <!-- Markdown will be rendered here by JavaScript -->
        </div>

        <!-- Hidden markdown content for JavaScript to process -->
        <script id="lesson-notes-markdown" type="text/plain"><%- lesson.notes %></script>

        <!-- Timestamps Full Section -->
        <% if (lesson.timestamps && lesson.timestamps.length > 0) { %>
        <section id="timestamps" class="lesson-section timestamps-section">
          <h2 class="section-heading">⏱️ Timestamps</h2>
          <% if (lesson.telegramLink) { %>
          <p class="timestamp-note">💡 Tip: Click timestamps to open Telegram, then manually seek to the shown time in the audio player.</p>
          <% } %>
          <div class="timestamps-grid">
            <% lesson.timestamps.forEach(timestamp => { %>
            <div class="timestamp-card">
              <span class="timestamp-card-time"><%= timestamp.time %></span>
              <span class="timestamp-card-description"><%= timestamp.description %></span>
              <% if (lesson.telegramLink || lesson.audioLink) { %>
              <a href="<%= lesson.telegramLink || lesson.audioLink %>" target="_blank" class="timestamp-card-link">
                <% if (lesson.telegramLink) { %>
                📱 Open in Telegram →
                <% } else { %>
                Jump to Audio →
                <% } %>
              </a>
              <% } %>
            </div>
            <% }); %>
          </div>
        </section>
        <% } %>

        <!-- Error Reporting Section -->
        <section class="lesson-section error-report-section">
          <div class="error-report-card">
            <h3 class="error-report-title">Found an Error?</h3>
            <p class="error-report-text">
              If you notice any mistakes in these notes, please help us improve by reporting them.
              These notes are AI-assisted and may contain errors.
            </p>
            <a href="mailto:corrections@example.com?subject=Error%20in%20Lesson%20<%= lesson.lessonNumber %>%20-%20<%= series.titleEnglish %>" class="btn-report">
              Report an Error
            </a>
          </div>
        </section>

      </article>
    </div>
  </main>

  <!-- Lesson Navigation -->
  <nav class="lesson-navigation">
    <div class="container">
      <div class="lesson-nav-grid">
        <div class="lesson-nav-item lesson-nav-prev">
          <% if (previousLesson) { %>
          <a href="/lesson/<%= series.seriesId %>/<%= previousLesson.lessonNumber %>" class="lesson-nav-link">
            <span class="nav-direction">← Previous Lesson</span>
            <span class="nav-lesson-title">
              <%= previousLesson.titleEnglish || `Lesson ${previousLesson.lessonNumber}` %>
            </span>
          </a>
          <% } else { %>
          <span class="lesson-nav-disabled">No previous lesson</span>
          <% } %>
        </div>

        <div class="lesson-nav-item lesson-nav-center">
          <a href="/series/<%= series.seriesId %>" class="lesson-nav-series">
            <span class="nav-series-icon">📚</span>
            <span class="nav-series-text">All Lessons</span>
          </a>
        </div>

        <div class="lesson-nav-item lesson-nav-next">
          <% if (nextLesson) { %>
          <a href="/lesson/<%= series.seriesId %>/<%= nextLesson.lessonNumber %>" class="lesson-nav-link">
            <span class="nav-direction">Next Lesson →</span>
            <span class="nav-lesson-title">
              <%= nextLesson.titleEnglish || `Lesson ${nextLesson.lessonNumber}` %>
            </span>
          </a>
          <% } else { %>
          <span class="lesson-nav-disabled">No next lesson yet</span>
          <% } %>
        </div>
      </div>
    </div>
  </nav>

  <!-- Footer -->
  <footer>
    <div class="footer-content">
      <div class="footer-note">
        <p><strong>Important Notice:</strong> These are unofficial AI-assisted student notes. They have not been reviewed or endorsed by Sheikh Hassan Dghriri. Always verify information from the original audio recordings.</p>
      </div>
      <p class="footer-copyright">&copy; 2025 Notes from the Majlis. Educational purposes only.</p>
    </div>
  </footer>

  <!-- JavaScript for Markdown Rendering and TOC Generation -->
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // Configure marked options
      marked.setOptions({
        breaks: true,
        gfm: true
      });

      // Get markdown content
      const markdownSource = document.getElementById('lesson-notes-markdown').textContent;

      // Render markdown to HTML
      const rawHtml = marked.parse(markdownSource);

      // Sanitize HTML with DOMPurify
      const cleanHtml = DOMPurify.sanitize(rawHtml);

      // Insert into page
      document.getElementById('lesson-notes-rendered').innerHTML = cleanHtml;

      // Generate Table of Contents from rendered headings
      generateTableOfContents();

      // Add Arabic text styling
      styleArabicText();

      // Fix bilingual heading order
      fixBilingualHeadings();

      // Smooth scroll for anchor links
      addSmoothScroll();
    });

    function generateTableOfContents() {
      const content = document.getElementById('lesson-notes-rendered');
      const toc = document.getElementById('toc-content');
      const headings = content.querySelectorAll('h2, h3');

      if (headings.length === 0) {
        toc.innerHTML = '<p class="toc-empty">No sections found</p>';
        return;
      }

      let tocHtml = '<ul class="toc-list">';
      let chapterCount = 1;

      headings.forEach((heading, index) => {
        // Add ID to heading if it doesn't have one
        if (!heading.id) {
          const id = 'section-' + index;
          heading.id = id;
        }

        // Check if this is a chapter heading
        if (heading.textContent.toLowerCase().includes('chapter')) {
          heading.id = 'chapter-' + chapterCount;
          chapterCount++;
        }

        const level = heading.tagName === 'H2' ? 'toc-level-1' : 'toc-level-2';
        let text = heading.textContent;

        // Apply bilingual swap to TOC text
        if (text.includes('|')) {
          const parts = text.split('|').map(s => s.trim());
          if (parts.length === 2) {
            const [part1, part2] = parts;
            const hasArabicPart1 = /[\u0600-\u06FF]/.test(part1);
            const hasArabicPart2 = /[\u0600-\u06FF]/.test(part2);

            // If first part is Arabic and second is not, swap them
            if (hasArabicPart1 && !hasArabicPart2) {
              text = `${part2} | ${part1}`;
            }
          }
        }

        tocHtml += `
          <li class="toc-item ${level}">
            <a href="#${heading.id}" class="toc-link">${text}</a>
          </li>
        `;
      });

      tocHtml += '</ul>';
      toc.innerHTML = tocHtml;
    }

    function styleArabicText() {
      const content = document.getElementById('lesson-notes-rendered');

      // Find all paragraphs and check if they contain Arabic text
      const paragraphs = content.querySelectorAll('p');

      paragraphs.forEach(p => {
        const text = p.textContent;
        // Simple check for Arabic characters
        if (/[\u0600-\u06FF]/.test(text)) {
          // If paragraph is mostly Arabic (more than 50% Arabic chars)
          const arabicChars = (text.match(/[\u0600-\u06FF]/g) || []).length;
          const totalChars = text.replace(/\s/g, '').length;

          if (arabicChars / totalChars > 0.5) {
            p.classList.add('arabic-paragraph');
            p.setAttribute('dir', 'rtl');
          } else {
            // Mixed content - wrap Arabic spans
            p.innerHTML = p.innerHTML.replace(
              /([\u0600-\u06FF\s]+)/g,
              '<span class="arabic-inline" dir="rtl">$1</span>'
            );
          }
        }
      });
    }

    function fixBilingualHeadings() {
      // Fix bilingual headings in markdown content
      const content = document.getElementById('lesson-notes-rendered');
      const markdownHeadings = content.querySelectorAll('h2, h3');

      markdownHeadings.forEach(heading => {
        swapBilingualText(heading);
      });

      // Fix bilingual headings in hero section
      const heroTitle = document.querySelector('.lesson-title-main');
      if (heroTitle) {
        swapBilingualText(heroTitle);
      }

      const heroArabicTitle = document.querySelector('.lesson-title-arabic');
      if (heroArabicTitle) {
        swapBilingualText(heroArabicTitle);
      }

      // Fix any other headings on the page
      const allHeadings = document.querySelectorAll('h1, h2, h3, h4, h5, h6');
      allHeadings.forEach(heading => {
        if (!heading.closest('#lesson-notes-rendered')) {
          swapBilingualText(heading);
        }
      });
    }

    function swapBilingualText(element) {
      const text = element.textContent;

      // Check if element contains pipe separator
      if (text.includes('|')) {
        const parts = text.split('|').map(s => s.trim());

        if (parts.length === 2) {
          const [part1, part2] = parts;

          // Check if part1 is Arabic and part2 is English
          const hasArabicPart1 = /[\u0600-\u06FF]/.test(part1);
          const hasArabicPart2 = /[\u0600-\u06FF]/.test(part2);

          // If first part is Arabic and second is not, swap them
          if (hasArabicPart1 && !hasArabicPart2) {
            element.innerHTML = `
              <span class="bilingual-en">${part2}</span>
              <span class="bilingual-separator"> | </span>
              <span class="bilingual-ar" dir="rtl">${part1}</span>
            `;
            element.classList.add('bilingual-heading');
          }
        }
      }
    }

    function addSmoothScroll() {
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const target = document.querySelector(this.getAttribute('href'));
          if (target) {
            target.scrollIntoView({
              behavior: 'smooth',
              block: 'start'
            });
          }
        });
      });
    }
  </script>

  <!-- Read Tracker Script -->
  <script src="/js/read-tracker.js"></script>

  <!-- Auto-mark lesson as read when page loads -->
  <script>
    // Wait for read tracker to initialize, then auto-mark as read
    document.addEventListener('DOMContentLoaded', () => {
      const lessonId = document.body.getAttribute('data-lesson-id');
      if (lessonId && window.readTracker) {
        // Small delay to ensure read tracker is fully initialized
        setTimeout(() => {
          window.readTracker.markAsRead(lessonId);
        }, 500);
      }
    });
  </script>

</body>
</html>
