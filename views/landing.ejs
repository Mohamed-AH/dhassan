<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Notes from the Majlis - Islamic Knowledge Resources</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600;700&family=Amiri:wght@400;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

  <!-- Navigation -->
  <nav>
    <div class="nav-container">
      <a href="/" class="logo">Notes from the Majlis</a>
      <ul class="nav-links">
        <li><a href="/" class="active">Home</a></li>
        <li><a href="/topics">Browse Topics</a></li>
        <li><a href="/series">Browse Series</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#sources">Sources</a></li>
        <% if (isAdmin) { %>
        <li><a href="/admin" style="color: var(--terracotta); font-weight: 600;">Admin Panel</a></li>
        <% } %>
        <% if (user) { %>
        <li><a href="/profile"><%= user.name %></a></li>
        <li><a href="/auth/logout">Logout</a></li>
        <% } else { %>
        <li><a href="/login" style="background: var(--terracotta); color: white; padding: 0.5rem 1rem; border-radius: 5px;">Login</a></li>
        <% } %>
      </ul>
    </div>
  </nav>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-content">
      <h1>Notes from the Majlis</h1>
      <p class="hero-subtitle">Student Notes & AI-Assisted Summaries from the Classes of Sheikh Hassan Dghriri</p>
      <p class="hero-arabic">Jami' Al-Wurud, Jeddah</p>

      <div class="hero-quote">
        <p>"Whoever takes a path in search of knowledge, Allah will make easy for him a path to Paradise."</p>
        <cite>— Sahih Muslim</cite>
      </div>

      <a href="#lessons" class="cta-button">Explore Lessons</a>
    </div>
  </section>

  <!-- Stats -->
  <section class="stats">
    <div class="stats-container">
      <div class="stat-item">
        <div class="stat-number"><%= totalSeries || 0 %></div>
        <div class="stat-label">Course Series</div>
      </div>
      <div class="stat-item">
        <div class="stat-number"><%= totalLessons || 0 %></div>
        <div class="stat-label">Lessons Available</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">∞</div>
        <div class="stat-label">Knowledge to Seek</div>
        <div class="stat-status">Ongoing <span class="beta-badge">Growing Library</span></div>
      </div>
    </div>
  </section>

  <!-- About Section -->
  <section id="about">
    <div class="container">
      <div class="section-header">
        <h2>A Window Into the Ocean</h2>
        <p>This platform serves as a digital companion for students seeking to benefit from the knowledge shared in Sheikh Hassan Dghriri's classes.</p>
      </div>

      <div class="about-grid">
        <div class="about-card">
          <h3>🎯 Our Purpose</h3>
          <p>To inspire and facilitate—not to replace—the authentic learning experience. Think of this as sitting in the back of a majlis, pen in hand, capturing the essence of what's being shared. We use AI to help organize and present these insights clearly.</p>
        </div>

        <div class="about-card">
          <h3>📚 Our Methodology</h3>
          <p>Each lesson is carefully transcribed from the original Arabic recordings, then summarized using AI assistance. The notes capture key concepts, hadiths, and teachings while maintaining the spirit of the sheikh's explanations.</p>
        </div>

        <div class="about-card">
          <h3>🌟 About the Sheikh</h3>
          <p>Sheikh Hassan Al-Daghriri studied under the renowned Sheikh Ahmed bin Yahya al-Najmi (may Allah have mercy on him), having spent years archiving his audio lessons and preparing his manuscripts for publication. With over 30 years dedicated to da'wah, he currently teaches at Jami' Al-Wurood in the Al-Wurood district of Jeddah.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Featured Series -->
  <% if (featuredSeries && featuredSeries.length > 0) { %>
  <section style="background: var(--warm-cream); padding: 3rem 0;">
    <div class="container">
      <div class="section-header">
        <h2>Featured Series</h2>
        <p>Explore our collection of Islamic studies series</p>
      </div>

      <div class="lessons-grid">
        <% featuredSeries.forEach(series => { %>
        <div class="lesson-card">
          <div class="lesson-meta">
            <span class="lesson-tag"><%= series.category || 'Islamic Studies' %></span>
            <span class="lesson-tag"><%= series.status || 'Ongoing' %></span>
          </div>

          <h3><%= series.titleEnglish %></h3>
          <% if (series.titleArabic) { %>
          <p class="arabic-title"><%= series.titleArabic %></p>
          <% } %>

          <% if (series.description) { %>
          <p class="lesson-excerpt">
            <%= series.description.length > 150 ? series.description.substring(0, 150) + '...' : series.description %>
          </p>
          <% } %>

          <div class="lesson-footer">
            <span class="lesson-info">
              By <%= series.author || 'Sheikh Hassan Dghriri' %>
            </span>
            <a href="/series/<%= series.seriesId %>" class="lesson-link">
              View Series →
            </a>
          </div>
        </div>
        <% }); %>
      </div>
    </div>
  </section>
  <% } %>

  <!-- Recent Lessons -->
  <section id="lessons" style="background: var(--soft-beige);">
    <div class="container">
      <div class="section-header">
        <h2>Recent Lessons</h2>
        <p>Explore the latest teachings and discussions from the majlis</p>
      </div>

      <div class="lessons-grid">
        <% if (recentLessons && recentLessons.length > 0) { %>
          <% recentLessons.forEach(lesson => { %>
          <div class="lesson-card">
            <div class="lesson-meta">
              <span class="lesson-tag">Lesson <%= lesson.lessonNumber %></span>
              <% if (lesson.hadithsDisplay) { %>
              <span class="lesson-tag"><%= lesson.hadithsDisplay %></span>
              <% } %>
              <% if (lesson.duration) { %>
              <span class="lesson-tag">⏱ <%= lesson.duration %></span>
              <% } %>
            </div>

            <h3><%= lesson.titleEnglish || `Lesson ${lesson.lessonNumber}` %></h3>
            <% if (lesson.titleArabic) { %>
            <p class="arabic-title"><%= lesson.titleArabic %></p>
            <% } %>

            <% if (lesson.summary) { %>
            <p class="lesson-excerpt">
              <%= lesson.summary.length > 200 ? lesson.summary.substring(0, 200) + '...' : lesson.summary %>
            </p>
            <% } %>

            <div class="lesson-footer">
              <span class="lesson-info">
                <%= new Date(lesson.dateGregorian || lesson.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
              </span>
              <a href="/lesson/<%= lesson.seriesId %>/<%= lesson.lessonNumber %>" class="lesson-link">
                View Notes →
              </a>
            </div>
          </div>
          <% }); %>
        <% } %>

        <!-- Placeholder for more lessons -->
        <div class="lesson-card coming-soon">
          <div class="lesson-meta">
            <span class="lesson-tag">Coming Soon</span>
          </div>

          <h3>More Lessons Coming</h3>
          <p class="arabic-title">المزيد من الدروس قادمة</p>

          <p class="lesson-excerpt">
            Additional lessons from Sheikh Hassan Dghriri's ongoing classes will be added regularly. Check back often for new content.
          </p>

          <div class="lesson-footer">
            <span class="lesson-info">📚 Stay tuned</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Official Sources -->
  <section id="sources">
    <div class="container">
      <div class="section-header">
        <h2>Official Sources</h2>
        <p>For authentic, unedited content directly from Sheikh Hassan Dghriri</p>
      </div>

      <div class="sources-grid">
        <div class="source-card">
          <div class="source-icon">📱</div>
          <h3>Telegram Channel</h3>
          <p class="arabic-subtitle">قناة شيخ حسن دغريري</p>
          <p>Daily updates, audio recordings, and class schedules</p>
          <p style="margin-top: 1rem;"><strong>t.me/darihhasan</strong></p>
        </div>

        <div class="source-card">
          <div class="source-icon">💬</div>
          <h3>WhatsApp Community</h3>
          <p class="arabic-subtitle">مجتمع الطلاب</p>
          <p>Join the community of students for class notifications and discussions</p>
        </div>

        <div class="source-card">
          <div class="source-icon">🕌</div>
          <h3>In Person</h3>
          <p class="arabic-subtitle">جامع الورود</p>
          <p>Al-Wurud District, Jeddah, Saudi Arabia<br><br>Regular classes throughout the week</p>
        </div>
      </div>

      <p style="text-align: center; margin-top: 3rem; color: var(--text-secondary); font-style: italic;">
        Always verify from official sources before acting on any knowledge
      </p>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="footer-content">
      <div class="footer-note">
        <p><strong>Important Notice:</strong> These are unofficial AI-assisted student notes created for educational purposes. They have not been reviewed, edited, or approved by Sheikh Hassan Dghriri.</p>
        <p>For Islamic rulings (fatawa), consult the Sheikh directly. For accurate quotes and complete context, listen to the original recordings. For deep understanding, attend the classes.</p>
        <p style="margin-top: 1rem; padding-top: 1rem; border-top: 1px solid rgba(255,255,255,0.1);"><em>The original audio/video recording is the ONLY authoritative source for the Sheikh's teachings.</em></p>
      </div>

      <div class="footer-links">
        <a href="/">Home</a>
        <a href="/topics">Topics</a>
        <a href="/series">Series</a>
        <a href="#about">About</a>
        <a href="mailto:corrections@example.com">Report an Error</a>
      </div>

      <p class="copyright">
        © 2025 Notes from the Majlis. Not affiliated with or endorsed by Sheikh Hassan Dghriri.<br>
        Unofficial student notes from Sheikh Hassan Dghriri's classes
      </p>
    </div>
  </footer>

</body>
</html>
