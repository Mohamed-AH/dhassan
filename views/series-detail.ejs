<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= series.titleEnglish %> - Notes from the Majlis</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Crimson+Pro:wght@400;600;700&family=Amiri:wght@400;700&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet">
</head>
<body>

  <!-- Navigation -->
  <nav>
    <div class="nav-container">
      <a href="/" class="logo">Notes from the Majlis</a>
      <ul class="nav-links">
        <li><a href="/">Home</a></li>
        <li><a href="/topics">Browse Topics</a></li>
        <li><a href="/series">Browse Series</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#sources">Sources</a></li>
        <% if (user) { %>
        <li><a href="/profile"><%= user.name %></a></li>
        <li><a href="/auth/logout">Logout</a></li>
        <% } %>
      </ul>
    </div>
  </nav>

  <!-- Breadcrumb -->
  <div class="breadcrumb-bar">
    <div class="container">
      <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-separator">/</span>
        <a href="/series">All Series</a>
        <span class="breadcrumb-separator">/</span>
        <span class="breadcrumb-current"><%= series.titleEnglish %></span>
      </nav>
    </div>
  </div>

  <!-- Series Hero -->
  <section class="hero">
    <div class="hero-content">
      <div style="display: inline-flex; align-items: center; gap: 1rem; margin-bottom: 1.5rem;">
        <span class="lesson-badge" style="background: rgba(255, 255, 255, 0.2);">
          <%= series.category %>
        </span>
        <span class="lesson-badge" style="background: rgba(255, 255, 255, 0.2);">
          <%= series.totalLessons || lessons.length %> Lessons
        </span>
        <span class="lesson-badge" style="background: rgba(255, 255, 255, 0.2);">
          <%= series.status %>
        </span>
      </div>

      <h1 style="margin-bottom: 1rem;"><%= series.titleEnglish %></h1>
      <% if (series.titleArabic) { %>
      <p class="hero-arabic" style="margin-bottom: 2rem;"><%= series.titleArabic %></p>
      <% } %>

      <p class="hero-subtitle" style="margin-bottom: 2rem;">
        By <%= series.author %>
      </p>

      <% if (series.description) { %>
      <div style="max-width: 800px; margin: 0 auto 2rem;">
        <p style="font-size: 1.1rem; line-height: 1.8; opacity: 0.95;">
          <%= series.description %>
        </p>
      </div>
      <% } %>

      <% if (series.telegramLink) { %>
      <div style="margin-top: 2rem;">
        <a href="<%= series.telegramLink %>" target="_blank" rel="noopener noreferrer" class="cta-button">
          <span style="font-size: 1.25rem;">📱</span>
          View on Telegram
        </a>
      </div>
      <% } %>
    </div>
  </section>

  <!-- Lessons List -->
  <main style="padding: 4rem 0; background: var(--warm-cream);">
    <div class="container">
      <div class="section-header" style="margin-bottom: 3rem;">
        <h2>All Lessons</h2>
        <p>Sequential lessons in this series</p>
      </div>

      <% if (lessons && lessons.length > 0) { %>
        <div class="lessons-grid">
          <% lessons.forEach(lesson => { %>
          <div class="lesson-card">
            <div class="lesson-meta">
              <span class="lesson-tag">Lesson <%= lesson.lessonNumber %></span>
              <% if (lesson.duration) { %>
              <span class="lesson-tag">⏱ <%= lesson.duration %></span>
              <% } %>
              <% if (lesson.hadithsDisplay) { %>
              <span class="lesson-tag"><%= lesson.hadithsDisplay %></span>
              <% } %>
            </div>

            <h3>
              <% if (lesson.titleEnglish) { %>
                <%= lesson.titleEnglish %>
              <% } else { %>
                Lesson <%= lesson.lessonNumber %>
              <% } %>
            </h3>

            <% if (lesson.titleArabic) { %>
            <p class="arabic-title"><%= lesson.titleArabic %></p>
            <% } %>

            <% if (lesson.summary) { %>
            <p class="lesson-excerpt"><%= lesson.summary.substring(0, 150) %><%= lesson.summary.length > 150 ? '...' : '' %></p>
            <% } %>

            <div class="lesson-footer">
              <span class="lesson-info">
                <%= new Date(lesson.dateGregorian || lesson.date).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %>
                <% if (lesson.dateHijri) { %>
                  <br><span style="font-size: 0.85rem; opacity: 0.8;"><%= lesson.dateHijri %></span>
                <% } %>
              </span>
              <a href="/lesson/<%= lesson._id %>" class="lesson-link">
                View Notes →
              </a>
            </div>
          </div>
          <% }); %>
        </div>
      <% } else { %>
        <div style="text-align: center; padding: 4rem 2rem; background: white; border-radius: var(--radius-lg); border: 1px solid var(--border-light);">
          <h3 style="font-family: var(--font-display); font-size: 1.5rem; color: var(--text-secondary); margin-bottom: 1rem;">
            No Lessons Yet
          </h3>
          <p style="color: var(--text-light);">Lessons for this series will be added soon. Check back later!</p>
          <% if (series.telegramLink) { %>
          <div style="margin-top: 2rem;">
            <a href="<%= series.telegramLink %>" target="_blank" rel="noopener noreferrer" class="btn-primary">
              Follow on Telegram for Updates
            </a>
          </div>
          <% } %>
        </div>
      <% } %>

    </div>
  </main>

  <!-- Footer -->
  <footer>
    <div class="footer-content">
      <div class="footer-note">
        <p><strong>Important Notice:</strong> These are unofficial AI-assisted student notes. They have not been reviewed or endorsed by Sheikh Hassan Dghriri. Always verify information from the original audio recordings.</p>
      </div>
      <p class="footer-copyright">&copy; 2025 Notes from the Majlis. Educational purposes only.</p>
    </div>
  </footer>

</body>
</html>
