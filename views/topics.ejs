<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Browse by Topics - Notes from the Majlis</title>
  <link rel="stylesheet" href="/css/styles.css">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Amiri:wght@400;700&display=swap" rel="stylesheet">
</head>
<body>

  <!-- Navigation -->
  <nav class="nav-main">
    <div class="nav-container">
      <a href="/" class="logo">Notes from the Majlis</a>
      <div class="nav-links">
        <a href="/">Home</a>
        <a href="/topics" class="active">Browse Topics</a>
        <a href="/series">Browse Series</a>
        <a href="/about">About</a>
        <% if (user) { %>
        <a href="/profile"><%= user.name %></a>
        <a href="/auth/logout">Logout</a>
        <% } else { %>
        <a href="/login" class="btn-primary-small">Sign In</a>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- Page Header -->
  <header class="page-header">
    <div class="page-header-content">
      <h1 class="page-title">Browse by Topic</h1>
      <p class="page-subtitle">Explore course series organized by subject matter</p>
    </div>
  </header>

  <!-- Main Content -->
  <main class="main-content">
    <div class="browse-container">

      <% if (seriesByCategory.Tafsir && seriesByCategory.Tafsir.length > 0) { %>
      <section class="category-section">
        <h2 class="category-title">Quranic Sciences (Tafsir)</h2>
        <div class="series-grid">
          <% seriesByCategory.Tafsir.forEach(series => { %>
          <div class="series-card">
            <h3 class="series-title"><%= series.titleEnglish %></h3>
            <% if (series.titleArabic) { %>
            <p class="series-title-ar"><%= series.titleArabic %></p>
            <% } %>
            <p class="series-author">By <%= series.author %></p>
            <div class="series-meta">
              <span><%= series.totalLessons || 0 %> lessons</span>
              <span><%= series.status %></span>
            </div>
            <% if (series.description) { %>
            <p class="series-description"><%= series.description.substring(0, 100) %>...</p>
            <% } %>
            <a href="/series/<%= series.seriesId %>" class="series-link">View Series</a>
          </div>
          <% }); %>
        </div>
      </section>
      <% } %>

      <% if (seriesByCategory.Aqeedah && seriesByCategory.Aqeedah.length > 0) { %>
      <section class="category-section">
        <h2 class="category-title">Islamic Creed (Aqeedah)</h2>
        <div class="series-grid">
          <% seriesByCategory.Aqeedah.forEach(series => { %>
          <div class="series-card">
            <h3 class="series-title"><%= series.titleEnglish %></h3>
            <% if (series.titleArabic) { %>
            <p class="series-title-ar"><%= series.titleArabic %></p>
            <% } %>
            <p class="series-author">By <%= series.author %></p>
            <div class="series-meta">
              <span><%= series.totalLessons || 0 %> lessons</span>
              <span><%= series.status %></span>
            </div>
            <% if (series.description) { %>
            <p class="series-description"><%= series.description.substring(0, 100) %>...</p>
            <% } %>
            <a href="/series/<%= series.seriesId %>" class="series-link">View Series</a>
          </div>
          <% }); %>
        </div>
      </section>
      <% } %>

      <% if (seriesByCategory.Fiqh && seriesByCategory.Fiqh.length > 0) { %>
      <section class="category-section">
        <h2 class="category-title">Islamic Jurisprudence (Fiqh)</h2>
        <div class="series-grid">
          <% seriesByCategory.Fiqh.forEach(series => { %>
          <div class="series-card">
            <h3 class="series-title"><%= series.titleEnglish %></h3>
            <% if (series.titleArabic) { %>
            <p class="series-title-ar"><%= series.titleArabic %></p>
            <% } %>
            <p class="series-author">By <%= series.author %></p>
            <div class="series-meta">
              <span><%= series.totalLessons || 0 %> lessons</span>
              <span><%= series.status %></span>
            </div>
            <% if (series.description) { %>
            <p class="series-description"><%= series.description.substring(0, 100) %>...</p>
            <% } %>
            <a href="/series/<%= series.seriesId %>" class="series-link">View Series</a>
          </div>
          <% }); %>
        </div>
      </section>
      <% } %>

      <% if (seriesByCategory.Hadith && seriesByCategory.Hadith.length > 0) { %>
      <section class="category-section">
        <h2 class="category-title">Hadith Studies</h2>
        <div class="series-grid">
          <% seriesByCategory.Hadith.forEach(series => { %>
          <div class="series-card">
            <h3 class="series-title"><%= series.titleEnglish %></h3>
            <% if (series.titleArabic) { %>
            <p class="series-title-ar"><%= series.titleArabic %></p>
            <% } %>
            <p class="series-author">By <%= series.author %></p>
            <div class="series-meta">
              <span><%= series.totalLessons || 0 %> lessons</span>
              <span><%= series.status %></span>
            </div>
            <% if (series.description) { %>
            <p class="series-description"><%= series.description.substring(0, 100) %>...</p>
            <% } %>
            <a href="/series/<%= series.seriesId %>" class="series-link">View Series</a>
          </div>
          <% }); %>
        </div>
      </section>
      <% } %>

      <% if (seriesByCategory.Khutbah && seriesByCategory.Khutbah.length > 0) { %>
      <section class="category-section">
        <h2 class="category-title">Sermons (Khutbah)</h2>
        <div class="series-grid">
          <% seriesByCategory.Khutbah.forEach(series => { %>
          <div class="series-card">
            <h3 class="series-title"><%= series.titleEnglish %></h3>
            <% if (series.titleArabic) { %>
            <p class="series-title-ar"><%= series.titleArabic %></p>
            <% } %>
            <p class="series-author">By <%= series.author %></p>
            <div class="series-meta">
              <span><%= series.totalLessons || 0 %> lessons</span>
              <span><%= series.status %></span>
            </div>
            <% if (series.description) { %>
            <p class="series-description"><%= series.description.substring(0, 100) %>...</p>
            <% } %>
            <a href="/series/<%= series.seriesId %>" class="series-link">View Series</a>
          </div>
          <% }); %>
        </div>
      </section>
      <% } %>

    </div>
  </main>

  <!-- Footer -->
  <footer class="footer">
    <div class="footer-bottom">
      <p>&copy; 2025 Notes from the Majlis. Not affiliated with or endorsed by Sheikh Hassan Dghriri.</p>
      <p>These are unofficial AI-assisted student notes. Always verify from original recordings.</p>
    </div>
  </footer>

</body>
</html>
